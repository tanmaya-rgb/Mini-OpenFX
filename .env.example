# Copy this file to .env and fill in real values for local development.

# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://miniopenfx:miniopenfx@localhost:5432/miniopenfx

# Redis (used as a short-TTL read-through cache in front of the pricing provider)
REDIS_URL=redis://localhost:6379

# Auth — single seeded API client for this assignment.
# The seed script creates a client row whose plaintext key is this value
# (only the hash is stored in the DB). Send it as: Authorization: Bearer <value>
SEED_CLIENT_API_KEY=dev-local-api-key-change-me

# Pricing provider
BINANCE_BASE_URL=https://api.binance.com
PRICE_CACHE_TTL_MS=1500
PRICING_TIMEOUT_MS=2000
PRICING_MAX_RETRIES=1

# Quotes
DEFAULT_QUOTE_TTL_SECONDS=15
QUOTE_SPREAD_BPS=10

# Dev-only endpoint that lets you top up a client's balance without a real
# funding flow, so trades can be demoed. Never enable this in production.
ENABLE_DEV_DEPOSITS=true
